{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"automerge": false,
	"draftPR": true,
	"extends": ["config:recommended", ":enableVulnerabilityAlerts"],
	"lockFileMaintenance": {
		"enabled": false
	},
	"minimumReleaseAge": "7 days",
	"packageRules": [
		{
			"description": "Every version lives once in the pnpm-workspace.yaml catalog and stays exact.",
			"matchDepTypes": ["pnpm.catalog.default"],
			"rangeStrategy": "pin"
		},
		{
			"description": "Workspace packages are released from this repository, never updated by Renovate.",
			"enabled": false,
			"matchPackageNames": ["@shivaedev/**"]
		},
		{
			"description": "Effect packages release together and must share one version, so they move in one update.",
			"groupName": "effect stack",
			"groupSlug": "effect-stack",
			"matchPackageNames": ["effect", "@effect/**"]
		},
		{
			"description": "Prisma Classic packages must share one version.",
			"groupName": "prisma",
			"groupSlug": "prisma",
			"matchPackageNames": ["prisma", "@prisma/**"]
		},
		{
			"description": "Prisma Next packages must share one version.",
			"groupName": "prisma next",
			"groupSlug": "prisma-next",
			"matchPackageNames": ["@prisma-next/**"]
		},
		{
			"allowedVersions": "<1.7.0",
			"description": "Better Auth stays on 1.6. Platform pins it as an exact peer, so moving to 1.7 is a planned migration, not a routine update.",
			"matchPackageNames": ["better-auth", "@better-auth/**"]
		}
	],
	"prConcurrentLimit": 3,
	"rebaseWhen": "conflicted",
	"schedule": ["* 0-5 * * 1"],
	"vulnerabilityAlerts": {
		"automerge": false,
		"draftPR": true,
		"prConcurrentLimit": 1
	}
}
