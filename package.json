{
	"name": "@shivaedev/platform-workspace",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@11.15.0+sha512.266f8957a30d2be6e9468e5e66bcdedd35a794175f71b067ba8504d686cce1d0c0f429b33c323c3c569ad4891e667574a49ff71d1b89a22cc66f13c65818c578",
	"engines": {
		"node": ">=24"
	},
	"imports": {
		"#*": "./script/*"
	},
	"scripts": {
		"build": "node packages/heavy-lock/src/cli.ts -- pnpm --recursive --workspace-concurrency=1 --if-present build",
		"check": "biome check .",
		"format": "biome check --write .",
		"heavy": "node packages/heavy-lock/src/cli.ts --",
		"lint": "pnpm check && node script/lint.ts && pnpm lint:quality && pnpm lint:boundaries",
		"lint:boundaries": "depcruise packages --config .dependency-cruiser.mjs",
		"lint:quality": "node packages/quality/src/cli.ts lint && node packages/quality/src/cli.ts baseline check",
		"test": "node packages/heavy-lock/src/cli.ts -- pnpm --recursive --workspace-concurrency=1 --if-present test",
		"test:package": "node packages/heavy-lock/src/cli.ts -- node script/package-check.ts",
		"typecheck": "node packages/heavy-lock/src/cli.ts -- sh -c 'pnpm typecheck:root && pnpm --recursive --workspace-concurrency=1 --if-present typecheck'",
		"typecheck:root": "tsc --noEmit",
		"ready": "pnpm lint && pnpm build && pnpm typecheck && pnpm test && pnpm test:package"
	},
	"devDependencies": {
		"@biomejs/biome": "catalog:",
		"@effect/platform-node": "catalog:",
		"@shivaedev/quality": "workspace:*",
		"@types/node": "catalog:",
		"@typescript/native": "catalog:",
		"dependency-cruiser": "catalog:",
		"effect": "catalog:",
		"ignore": "catalog:",
		"typescript": "catalog:"
	}
}
