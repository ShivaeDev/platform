{
	"name": "@shivaedev/platform-workspace",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"imports": {
		"#*": "./script/*"
	},
	"scripts": {
		"build": "node packages/heavy-lock/src/cli.ts -- pnpm --recursive --workspace-concurrency=1 --if-present build",
		"db:setup": "node --conditions=source --env-file-if-exists=.env.local script/setup-database.ts",
		"format": "node packages/quality/src/cli.ts fix",
		"heavy": "node packages/heavy-lock/src/cli.ts --",
		"lint": "node script/lint.ts && pnpm lint:quality && pnpm lint:boundaries",
		"lint:boundaries": "node script/lint-boundaries.ts",
		"lint:quality": "node packages/quality/src/cli.ts lint && node packages/quality/src/cli.ts baseline check",
		"ready": "pnpm lint && pnpm build && pnpm typecheck && pnpm test && pnpm test:package",
		"setup": "pnpm install --frozen-lockfile && pnpm db:setup",
		"test": "node --conditions=source --env-file-if-exists=.env.local script/test.ts",
		"test:package": "node packages/heavy-lock/src/cli.ts -- node script/package-check.ts",
		"typecheck": "node packages/heavy-lock/src/cli.ts -- sh -c 'pnpm typecheck:root && pnpm --recursive --workspace-concurrency=1 --if-present typecheck'",
		"typecheck:root": "tsc --noEmit"
	},
	"devDependencies": {
		"@biomejs/biome": "catalog:",
		"@effect/platform-node": "catalog:",
		"@shivaedev/local-postgres": "workspace:*",
		"@shivaedev/quality": "workspace:*",
		"@types/node": "catalog:",
		"@typescript/native": "catalog:",
		"dependency-cruiser": "catalog:",
		"effect": "catalog:",
		"ignore": "catalog:",
		"typescript": "catalog:"
	},
	"packageManager": "pnpm@12.8.1+sha512.f64ba907507f5ceafe06c8d38e6052d0179444580ec1279ddd5bfc11cb48aa8a2644b66598e07e761da84872a9fc57d5f902b87fa49d024198d558612aabbe45",
	"engines": {
		"node": ">=24"
	}
}
