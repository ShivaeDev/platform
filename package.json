{
	"name": "@shivaedev/platform-workspace",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"imports": {
		"#*": "./script/*"
	},
	"scripts": {
		"build": "node --conditions=source packages/heavy-lock/src/cli.ts -- pnpm --recursive --sort=${CI_WORKSPACE_SORT:-true} --workspace-concurrency=${CI_WORKSPACE_CONCURRENCY:-1} --if-present build",
		"changelog:check": "node --conditions=source script/changelog.ts check",
		"changelog:release": "node --conditions=source script/changelog.ts",
		"check:generated-app-versions": "node --conditions=source script/check-generated-app-versions.ts",
		"codecov:components": "node --conditions=source script/codecov-components.ts",
		"db:setup": "node --conditions=source --env-file-if-exists=.env.local script/setup-database.ts",
		"format": "node --conditions=source packages/quality/src/cli.ts fix",
		"heavy": "node --conditions=source packages/heavy-lock/src/cli.ts --",
		"hooks": "node --conditions=source packages/quality/src/cli.ts hooks install",
		"lint": "node --conditions=source script/lint.ts && pnpm changelog:check && pnpm lint:quality",
		"lint:quality": "node --conditions=source packages/quality/src/cli.ts lint",
		"quality:commit": "node --conditions=source script/lint.ts && pnpm changelog:check",
		"ready": "pnpm lint && pnpm test:orchestration && pnpm build && pnpm typecheck && pnpm test && pnpm test:package --prepare .ci/packages && pnpm test:package --archives .ci/packages && pnpm --filter @shivaedev/starter check:published --archives .ci/packages",
		"report:bundles": "node --conditions=source script/ci/bundles.ts",
		"setup": "pnpm install --frozen-lockfile && pnpm hooks && pnpm db:setup",
		"test": "node --conditions=source --env-file-if-exists=.env.local script/test.ts",
		"test:orchestration": "node --conditions=source --test script/ci/*.test.ts script/package-check/archives.test.ts script/package-check/server.test.ts script/changelog/*.test.ts script/starter-published/*.test.ts",
		"test:package": "node --conditions=source packages/heavy-lock/src/cli.ts -- node script/package-check.ts",
		"typecheck": "node --conditions=source packages/heavy-lock/src/cli.ts -- sh -c 'pnpm typecheck:root && pnpm --recursive --workspace-concurrency=${CI_WORKSPACE_CONCURRENCY:-1} --if-present typecheck'",
		"typecheck:root": "tsc --noEmit"
	},
	"devDependencies": {
		"@biomejs/biome": "catalog:",
		"@codecov/bundle-analyzer": "catalog:",
		"@effect/platform-node": "catalog:",
		"@shivaedev/local-postgres": "workspace:*",
		"@shivaedev/quality": "workspace:*",
		"@types/node": "catalog:",
		"@typescript/native": "catalog:",
		"@vitest/coverage-v8": "catalog:",
		"effect": "catalog:",
		"ignore": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	},
	"packageManager": "pnpm@12.10.1+sha512.ba40a37eb1a370d60fea8c4cf1d364c13bcccef518e98ad2bcee954f539d38da37458e58261a3fa55e06523450ea0ffff9f497b135be41f2c15c1642bacace6c",
	"engines": {
		"node": ">=24"
	}
}
