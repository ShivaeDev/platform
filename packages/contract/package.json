{
	"name": "@shivaedev/contract",
	"version": "0.22.0",
	"description": "Typed query and command contracts over native Effect RPC and reactivity",
	"keywords": [
		"effect"
	],
	"homepage": "https://github.com/ShivaeDev/platform/tree/main/packages/contract#readme",
	"bugs": {
		"url": "https://github.com/ShivaeDev/platform/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ShivaeDev/platform.git",
		"directory": "packages/contract"
	},
	"license": "MIT",
	"sideEffects": false,
	"type": "module",
	"imports": {
		"#test/*": "./src/test-support/*",
		"#*.ts": {
			"source": "./src/*.ts",
			"types": "./dist/*.d.ts",
			"default": "./dist/*.js"
		}
	},
	"exports": {
		"./*.ts": {
			"source": "./src/*.ts",
			"types": "./dist/*.d.ts",
			"default": "./dist/*.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"src",
		"!src/**/*.test.ts",
		"!src/**/*.spec.ts",
		"!src/**/test-support",
		"CHANGELOG.md",
		"README.md"
	],
	"scripts": {
		"build": "node --eval \"import('node:fs').then(({ rmSync }) => rmSync('dist', { force: true, recursive: true }))\" && tsc --project tsconfig.build.json",
		"ready": "pnpm typecheck && pnpm test && pnpm build",
		"test": "vitest run",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@shivaedev/changes": "workspace:*",
		"@shivaedev/types": "workspace:*"
	},
	"devDependencies": {
		"@effect/platform-node": "catalog:",
		"@effect/vitest": "catalog:",
		"@shivaedev/quality": "workspace:*",
		"@shivaedev/test": "workspace:*",
		"@shivaedev/test-sql": "workspace:*",
		"@shivaedev/test-story": "workspace:*",
		"@types/node": "catalog:",
		"effect": "catalog:",
		"esbuild": "catalog:",
		"happy-dom": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	},
	"peerDependencies": {
		"effect": "catalog:"
	},
	"engines": {
		"node": ">=24"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	}
}
