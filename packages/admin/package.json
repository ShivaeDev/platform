{
	"name": "@shivaedev/admin",
	"version": "0.10.1",
	"description": "Explicit admin page contracts and a protected native Effect RPC registry",
	"homepage": "https://github.com/ShivaeDev/platform/tree/main/packages/admin#readme",
	"bugs": {
		"url": "https://github.com/ShivaeDev/platform/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ShivaeDev/platform.git",
		"directory": "packages/admin"
	},
	"license": "MIT",
	"sideEffects": false,
	"type": "module",
	"imports": {
		"#test/*": "./src/test-support/*",
		"#*.ts": {
			"source": "./src/*.ts",
			"types": "./dist/*.d.ts",
			"default": "./dist/*.js"
		}
	},
	"exports": {
		"./*.ts": {
			"source": "./src/*.ts",
			"types": "./dist/*.d.ts",
			"default": "./dist/*.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"src",
		"!src/**/*.test.ts",
		"!src/**/*.test.tsx",
		"!src/**/*.spec.ts",
		"!src/**/*.spec.tsx",
		"!src/**/test-support",
		"README.md"
	],
	"scripts": {
		"build": "node --eval \"import('node:fs').then(({ rmSync }) => rmSync('dist', { force: true, recursive: true }))\" && tsc --project tsconfig.build.json",
		"ready": "pnpm typecheck && pnpm test && pnpm build",
		"test": "vitest run",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@shivaedev/access": "workspace:*",
		"@shivaedev/changes": "workspace:*",
		"@shivaedev/contract": "workspace:*",
		"@shivaedev/errors": "workspace:*",
		"@shivaedev/identity": "workspace:*",
		"@shivaedev/jobs": "workspace:*",
		"@shivaedev/react": "workspace:*",
		"@shivaedev/sql": "workspace:*"
	},
	"devDependencies": {
		"@effect/atom-react": "catalog:",
		"@shivaedev/quality": "workspace:*",
		"@shivaedev/server": "workspace:*",
		"@shivaedev/test-sql": "workspace:*",
		"@shivaedev/test-story": "workspace:*",
		"@types/node": "catalog:",
		"@types/react": "catalog:",
		"@types/react-dom": "catalog:",
		"effect": "catalog:",
		"happy-dom": "catalog:",
		"react": "catalog:",
		"react-dom": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	},
	"peerDependencies": {
		"@effect/atom-react": "catalog:",
		"effect": "catalog:",
		"react": "catalog:"
	},
	"engines": {
		"node": ">=24"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	}
}
