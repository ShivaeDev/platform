{
	"name": "@shivaedev/effect-changes-prisma",
	"version": "0.3.3",
	"description": "Commit-bound change channels for Prisma Classic on PostgreSQL only: automatic change recording, publish after $transaction commits, and a test-time coverage check",
	"homepage": "https://github.com/ShivaeDev/platform/tree/main/packages/effect-changes-prisma#readme",
	"bugs": {
		"url": "https://github.com/ShivaeDev/platform/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ShivaeDev/platform.git",
		"directory": "packages/effect-changes-prisma"
	},
	"license": "MIT",
	"sideEffects": false,
	"type": "module",
	"imports": {
		"#test/*": "./test/*",
		"#*.ts": {
			"source": "./src/*.ts",
			"types": "./dist/*.d.ts",
			"default": "./dist/*.js"
		}
	},
	"exports": {
		"./*.ts": {
			"types": "./dist/*.d.ts",
			"source": "./src/*.ts",
			"import": "./dist/*.js",
			"default": "./dist/*.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"src",
		"CHANGELOG.md",
		"README.md"
	],
	"scripts": {
		"build": "node --eval \"import('node:fs').then(({ rmSync }) => rmSync('dist', { force: true, recursive: true }))\" && tsc6 --project tsconfig.build.json",
		"ready": "pnpm typecheck && pnpm test && pnpm build",
		"test": "prisma generate --config test/prisma.config.ts --no-hints && vitest run",
		"typecheck": "prisma generate --config test/prisma.config.ts --no-hints && tsc --noEmit"
	},
	"dependencies": {
		"@shivaedev/effect-changes": "workspace:*",
		"@shivaedev/types": "workspace:*"
	},
	"devDependencies": {
		"@prisma/adapter-pg": "catalog:",
		"@prisma/client": "catalog:",
		"@shivaedev/quality": "workspace:*",
		"@types/node": "catalog:",
		"@typescript/native": "catalog:",
		"effect": "catalog:",
		"prisma": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	},
	"peerDependencies": {
		"@prisma/client": "catalog:",
		"effect": "catalog:"
	},
	"engines": {
		"node": ">=24"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	}
}
