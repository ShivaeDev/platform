{
	"name": "@shivaedev/effect-changes-prisma",
	"version": "0.2.1",
	"description": "Commit-bound change channels for Prisma Classic: automatic change recording, publish after $transaction commits, and a test-time coverage check",
	"type": "module",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ShivaeDev/platform.git",
		"directory": "packages/effect-changes-prisma"
	},
	"homepage": "https://github.com/ShivaeDev/platform/tree/main/packages/effect-changes-prisma#readme",
	"bugs": {
		"url": "https://github.com/ShivaeDev/platform/issues"
	},
	"engines": {
		"node": ">=24"
	},
	"sideEffects": false,
	"files": [
		"dist",
		"src",
		"CHANGELOG.md",
		"README.md"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"source": "./src/index.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"scripts": {
		"build": "node --eval \"import('node:fs').then(({ rmSync }) => rmSync('dist', { force: true, recursive: true }))\" && tsc6 --project tsconfig.build.json",
		"check": "biome check .",
		"test": "prisma generate --config test/prisma.config.ts --no-hints && vitest run",
		"typecheck": "prisma generate --config test/prisma.config.ts --no-hints && tsc --noEmit",
		"ready": "pnpm check && pnpm typecheck && pnpm test && pnpm build"
	},
	"dependencies": {
		"@shivaedev/effect-changes": "workspace:*"
	},
	"peerDependencies": {
		"@prisma/client": "catalog:",
		"effect": "catalog:"
	},
	"devDependencies": {
		"@prisma/adapter-pg": "catalog:",
		"@prisma/client": "catalog:",
		"@types/node": "catalog:",
		"@typescript/native": "catalog:",
		"effect": "catalog:",
		"prisma": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
