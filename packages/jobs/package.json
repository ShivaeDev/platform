{
	"name": "@shivaedev/jobs",
	"version": "0.22.1",
	"description": "Effect-native jobs and lifecycle management for pg-boss",
	"keywords": [
		"effect"
	],
	"homepage": "https://github.com/ShivaeDev/platform/tree/main/packages/jobs#readme",
	"bugs": {
		"url": "https://github.com/ShivaeDev/platform/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ShivaeDev/platform.git",
		"directory": "packages/jobs"
	},
	"license": "MIT",
	"sideEffects": false,
	"type": "module",
	"imports": {
		"#test/*": "./src/test-support/*",
		"#*.ts": {
			"source": "./src/server/*.ts",
			"types": "./dist/server/*.d.ts",
			"default": "./dist/server/*.js"
		},
		"#JobFailure.ts": {
			"source": "./src/JobFailure.ts",
			"types": "./dist/JobFailure.d.ts",
			"default": "./dist/JobFailure.js"
		}
	},
	"exports": {
		"./*.ts": {
			"source": "./src/*.ts",
			"types": "./dist/*.d.ts",
			"default": "./dist/*.js"
		},
		"./package.json": "./package.json",
		"./server/internal/*": null
	},
	"files": [
		"dist",
		"src",
		"!src/**/*.test.ts",
		"!src/**/*.spec.ts",
		"!src/**/test-support",
		"CHANGELOG.md",
		"README.md"
	],
	"scripts": {
		"build": "node --eval \"import('node:fs').then(({ rmSync }) => rmSync('dist', { force: true, recursive: true }))\" && tsc --project tsconfig.build.json",
		"ready": "pnpm typecheck && pnpm test && pnpm build",
		"test": "vitest run",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@shivaedev/errors": "workspace:*",
		"@shivaedev/sql": "workspace:*"
	},
	"devDependencies": {
		"@shivaedev/quality": "workspace:*",
		"@shivaedev/test": "workspace:*",
		"@shivaedev/test-sql": "workspace:*",
		"@shivaedev/test-story": "workspace:*",
		"@types/node": "catalog:",
		"effect": "catalog:",
		"pg-boss": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	},
	"peerDependencies": {
		"effect": "catalog:",
		"pg-boss": "catalog:"
	},
	"engines": {
		"node": ">=24"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	}
}
