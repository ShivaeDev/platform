{
	"name": "@shivaedev/agent-pi",
	"version": "0.4.0",
	"description": "Pi integration for Effect applications",
	"homepage": "https://github.com/ShivaeDev/platform/tree/main/packages/agent-pi#readme",
	"bugs": {
		"url": "https://github.com/ShivaeDev/platform/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ShivaeDev/platform.git",
		"directory": "packages/agent-pi"
	},
	"license": "MIT",
	"sideEffects": false,
	"type": "module",
	"imports": {
		"#*.ts": {
			"@shivaedev/source": "./src/*.ts",
			"types": "./dist/*.d.ts",
			"default": "./dist/*.js"
		},
		"#test/*": "./src/test-support/*"
	},
	"exports": {
		"./*.ts": {
			"@shivaedev/source": "./src/*.ts",
			"types": "./dist/*.d.ts",
			"default": "./dist/*.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"src",
		"!src/**/*.test.ts",
		"!src/**/*.spec.ts",
		"!src/**/test-support",
		"CHANGELOG.md",
		"README.md"
	],
	"scripts": {
		"build": "node --eval \"import('node:fs').then(({ rmSync }) => rmSync('dist', { force: true, recursive: true }))\" && tsc --project tsconfig.build.json",
		"ready": "pnpm typecheck && pnpm test && pnpm build",
		"test": "vitest run --configLoader native",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@shivaedev/agent": "workspace:*"
	},
	"devDependencies": {
		"@earendil-works/pi-coding-agent": "catalog:",
		"@effect/vitest": "catalog:",
		"@shivaedev/quality": "workspace:*",
		"@shivaedev/test-story": "workspace:*",
		"@types/node": "catalog:",
		"effect": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "catalog:",
		"effect": "catalog:"
	},
	"peerDependenciesMeta": {
		"@earendil-works/pi-coding-agent": {
			"optional": true
		}
	},
	"engines": {
		"node": ">=24"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	}
}
