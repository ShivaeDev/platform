{
	"name": "@shivaedev/effect-form",
	"version": "0.1.2",
	"description": "Schema-derived Effect atom forms with optional React hooks",
	"homepage": "https://github.com/ShivaeDev/platform/tree/main/packages/effect-form#readme",
	"bugs": {
		"url": "https://github.com/ShivaeDev/platform/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ShivaeDev/platform.git",
		"directory": "packages/effect-form"
	},
	"license": "MIT",
	"sideEffects": false,
	"type": "module",
	"imports": {
		"#test/*": "./test/*",
		"#*.ts": {
			"source": "./src/*.ts",
			"types": "./dist/*.d.ts",
			"default": "./dist/*.js"
		}
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"source": "./src/index.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./package.json": "./package.json",
		"./react": {
			"types": "./dist/react.d.ts",
			"source": "./src/react.ts",
			"import": "./dist/react.js",
			"default": "./dist/react.js"
		}
	},
	"files": [
		"dist",
		"src",
		"CHANGELOG.md",
		"README.md"
	],
	"scripts": {
		"build": "node --eval \"import('node:fs').then(({ rmSync }) => rmSync('dist', { force: true, recursive: true }))\" && tsc6 --project tsconfig.build.json",
		"ready": "pnpm typecheck && pnpm test && pnpm build",
		"test": "vitest run",
		"typecheck": "tsc --noEmit"
	},
	"devDependencies": {
		"@effect/atom-react": "catalog:",
		"@effect/vitest": "catalog:",
		"@shivaedev/quality": "workspace:*",
		"@types/node": "catalog:",
		"@types/react": "catalog:",
		"@typescript/native": "catalog:",
		"effect": "catalog:",
		"react": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	},
	"peerDependencies": {
		"@effect/atom-react": "catalog:",
		"effect": "catalog:",
		"react": "catalog:"
	},
	"peerDependenciesMeta": {
		"@effect/atom-react": {
			"optional": true
		},
		"react": {
			"optional": true
		}
	},
	"engines": {
		"node": ">=24"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	}
}
