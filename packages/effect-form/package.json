{
	"name": "@shivaedev/effect-form",
	"version": "0.4.0",
	"description": "Schema-derived Effect atom forms with optional React hooks",
	"homepage": "https://github.com/ShivaeDev/platform/tree/main/packages/effect-form#readme",
	"bugs": {
		"url": "https://github.com/ShivaeDev/platform/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ShivaeDev/platform.git",
		"directory": "packages/effect-form"
	},
	"license": "MIT",
	"sideEffects": false,
	"type": "module",
	"imports": {
		"#test/*": "./src/test-support/*",
		"#*.ts": {
			"types": "./dist/*.d.ts",
			"source": "./src/*.ts",
			"default": "./dist/*.js"
		},
		"#react.ts": {
			"types": "./dist/client/react.d.ts",
			"source": "./src/client/react.ts",
			"default": "./dist/client/react.js"
		}
	},
	"exports": {
		"./package.json": "./package.json",
		"./draft.ts": {
			"types": "./dist/draft.d.ts",
			"source": "./src/draft.ts",
			"default": "./dist/draft.js"
		},
		"./form.ts": {
			"types": "./dist/form.d.ts",
			"source": "./src/form.ts",
			"default": "./dist/form.js"
		},
		"./messages.ts": {
			"types": "./dist/messages.d.ts",
			"source": "./src/messages.ts",
			"default": "./dist/messages.js"
		},
		"./optional.ts": {
			"types": "./dist/optional.d.ts",
			"source": "./src/optional.ts",
			"default": "./dist/optional.js"
		},
		"./paths.ts": {
			"types": "./dist/paths.d.ts",
			"source": "./src/paths.ts",
			"default": "./dist/paths.js"
		},
		"./react.ts": {
			"types": "./dist/client/react.d.ts",
			"source": "./src/client/react.ts",
			"default": "./dist/client/react.js"
		},
		"./refs.ts": {
			"types": "./dist/refs.d.ts",
			"source": "./src/refs.ts",
			"default": "./dist/refs.js"
		},
		"./shape.ts": {
			"types": "./dist/shape.d.ts",
			"source": "./src/shape.ts",
			"default": "./dist/shape.js"
		},
		"./status.ts": {
			"types": "./dist/status.d.ts",
			"source": "./src/status.ts",
			"default": "./dist/status.js"
		},
		"./trackRejections.ts": {
			"types": "./dist/trackRejections.d.ts",
			"source": "./src/trackRejections.ts",
			"default": "./dist/trackRejections.js"
		},
		"./persistence.ts": {
			"types": "./dist/persistence.d.ts",
			"source": "./src/persistence.ts",
			"default": "./dist/persistence.js"
		},
		"./draftSession.ts": {
			"types": "./dist/draftSession.d.ts",
			"source": "./src/draftSession.ts",
			"default": "./dist/draftSession.js"
		}
	},
	"files": [
		"dist",
		"src",
		"!src/**/*.test.ts",
		"!src/**/*.spec.ts",
		"!src/**/test-support",
		"docs",
		"CHANGELOG.md",
		"README.md"
	],
	"scripts": {
		"build": "node --eval \"import('node:fs').then(({ rmSync }) => rmSync('dist', { force: true, recursive: true }))\" && tsc --project tsconfig.build.json",
		"ready": "pnpm typecheck && pnpm test && pnpm build",
		"test": "vitest run",
		"typecheck": "tsc --noEmit"
	},
	"devDependencies": {
		"@effect/atom-react": "catalog:",
		"@effect/vitest": "catalog:",
		"@shivaedev/effect-test": "workspace:*",
		"@shivaedev/quality": "workspace:*",
		"@shivaedev/test-story": "workspace:*",
		"@types/node": "catalog:",
		"@types/react": "catalog:",
		"@typescript/native": "catalog:",
		"effect": "catalog:",
		"react": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	},
	"peerDependencies": {
		"@effect/atom-react": "catalog:",
		"effect": "catalog:",
		"react": "catalog:"
	},
	"peerDependenciesMeta": {
		"@effect/atom-react": {
			"optional": true
		},
		"react": {
			"optional": true
		}
	},
	"engines": {
		"node": ">=24"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	}
}
