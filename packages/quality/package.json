{
	"name": "@shivaedev/quality",
	"version": "0.42.0",
	"description": "Repository quality gate with typed rules, a baseline of existing debt and a registry of reasoned exceptions",
	"homepage": "https://github.com/ShivaeDev/platform/tree/main/packages/quality#readme",
	"bugs": {
		"url": "https://github.com/ShivaeDev/platform/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ShivaeDev/platform.git",
		"directory": "packages/quality"
	},
	"license": "MIT",
	"sideEffects": false,
	"type": "module",
	"imports": {
		"#test/*": "./src/test-support/*",
		"#*.ts": {
			"source": "./src/*.ts",
			"types": "./dist/*.d.ts",
			"default": "./dist/*.js"
		}
	},
	"exports": {
		"./*.ts": {
			"source": "./src/*.ts",
			"types": "./dist/*.d.ts",
			"default": "./dist/*.js"
		},
		"./biome/preset.json": "./biome/preset.json",
		"./tsconfig/base.json": "./tsconfig/base.json",
		"./tsconfig/package.json": "./tsconfig/package.json",
		"./package.json": "./package.json",
		"./domEnvironment.config.ts": null,
		"./unitIoGuard.config.ts": null,
		"./imports/isTooling.ts": null,
		"./rules/imports/bundleInputs.ts": null,
		"./inventory/shadcnFolders.ts": null,
		"./inventory/shadcnAlias.ts": null,
		"./naming/migrationFile.ts": null,
		"./tsconfig/app.json": "./tsconfig/app.json"
	},
	"bin": {
		"quality": "./dist/cli.js"
	},
	"files": [
		"dist",
		"biome",
		"src",
		"!src/**/*.test.ts",
		"!src/**/*.spec.ts",
		"!src/**/test-support",
		"tsconfig",
		"docs",
		"CHANGELOG.md",
		"README.md"
	],
	"scripts": {
		"build": "node --eval \"import('node:fs').then(({ rmSync }) => rmSync('dist', { force: true, recursive: true }))\" && tsc --project tsconfig.build.json",
		"ready": "pnpm typecheck && pnpm test && pnpm build",
		"test": "vitest run --configLoader native",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@biomejs/biome": "catalog:",
		"@shivaedev/types": "workspace:*",
		"ignore": "catalog:",
		"sort-package-json": "catalog:",
		"typescript": "catalog:compiler-api"
	},
	"devDependencies": {
		"@effect/platform-node": "catalog:",
		"@effect/platform-node-shared": "catalog:",
		"@effect/vitest": "catalog:",
		"@types/node": "catalog:",
		"@typescript/native": "catalog:",
		"effect": "catalog:",
		"vitest": "catalog:"
	},
	"peerDependencies": {
		"@effect/platform-node": "catalog:",
		"@effect/platform-node-shared": "catalog:",
		"effect": "catalog:",
		"vitest": "catalog:"
	},
	"peerDependenciesMeta": {
		"vitest": {
			"optional": true
		}
	},
	"engines": {
		"node": ">=24"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	}
}
