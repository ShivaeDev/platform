engine biome(1.0)
language js(typescript, jsx)

or {
	or {
		`export type { $names } from $source` as $match,
		`export type * from $source` as $match,
		`export type * as $namespace from $source` as $match
	},
	`export type $alias = $original` as $match where {
		$original <: r"[A-Za-z_$][A-Za-z0-9_$]*",
		$match <: within {
			contains or {
				`import type { $imports } from $source`,
				`import { $imports } from $source`
			} where {
				$imports <: contains or {
					`$original`,
					`$imported as $original`,
					`type $original`,
					`type $imported as $original`
				}
			}
		}
	},
	`export type $alias = $original` as $match where {
		$match <: within {
			contains or {
				`import type $original from $source`,
				`import $original from $source`
			}
		}
	}
} where {
	register_diagnostic(span=$match, message=`A module never re-exports, types included.
Help: Import the type from $source, the module that defines it, and remove the second name.`)
}
