{
	"name": "@shivaedev/platform",
	"version": "0.5.0",
	"description": "Opinionated Effect application infrastructure for ShivaeDev services",
	"homepage": "https://github.com/ShivaeDev/platform/tree/main/packages/platform#readme",
	"bugs": {
		"url": "https://github.com/ShivaeDev/platform/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ShivaeDev/platform.git",
		"directory": "packages/platform"
	},
	"license": "MIT",
	"sideEffects": false,
	"type": "module",
	"imports": {
		"#test/*": "./test/*",
		"#*.ts": {
			"source": "./src/*.ts",
			"types": "./dist/*.d.ts",
			"default": "./dist/*.js"
		}
	},
	"exports": {
		"./better-auth": {
			"types": "./dist/better-auth.d.ts",
			"source": "./src/better-auth.ts",
			"import": "./dist/better-auth.js",
			"default": "./dist/better-auth.js"
		},
		"./runtime": {
			"types": "./dist/runtime.d.ts",
			"source": "./src/runtime.ts",
			"import": "./dist/runtime.js",
			"default": "./dist/runtime.js"
		},
		"./node-http": {
			"types": "./dist/node-http.d.ts",
			"source": "./src/node-http.ts",
			"import": "./dist/node-http.js",
			"default": "./dist/node-http.js"
		},
		"./testing": {
			"types": "./dist/testing.d.ts",
			"source": "./src/testing.ts",
			"import": "./dist/testing.js",
			"default": "./dist/testing.js"
		},
		"./errors": {
			"types": "./dist/errors.d.ts",
			"source": "./src/errors.ts",
			"import": "./dist/errors.js",
			"default": "./dist/errors.js"
		},
		"./rpc": {
			"types": "./dist/rpc.d.ts",
			"source": "./src/rpc.ts",
			"import": "./dist/rpc.js",
			"default": "./dist/rpc.js"
		},
		"./rpc-server": {
			"types": "./dist/rpc-server.d.ts",
			"source": "./src/rpc-server.ts",
			"import": "./dist/rpc-server.js",
			"default": "./dist/rpc-server.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"src",
		"CHANGELOG.md",
		"README.md"
	],
	"scripts": {
		"build": "node --eval \"import('node:fs').then(({ rmSync }) => rmSync('dist', { force: true, recursive: true }))\" && tsc6 --project tsconfig.build.json",
		"ready": "pnpm typecheck && pnpm test && pnpm build",
		"test": "vitest run",
		"typecheck": "tsc --noEmit"
	},
	"devDependencies": {
		"@effect/vitest": "catalog:",
		"@prisma-next/adapter-postgres": "catalog:",
		"@prisma-next/contract": "catalog:",
		"@prisma-next/postgres": "catalog:",
		"@prisma-next/sql-contract": "catalog:",
		"@prisma-next/target-postgres": "catalog:",
		"@shivaedev/effect-prisma": "workspace:*",
		"@shivaedev/effect-trpc": "workspace:*",
		"@shivaedev/quality": "workspace:*",
		"@shivaedev/types": "workspace:*",
		"@trpc/client": "catalog:",
		"@trpc/server": "catalog:",
		"@types/node": "catalog:",
		"@typescript/native": "catalog:",
		"better-auth": "catalog:",
		"effect": "catalog:",
		"superjson": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	},
	"peerDependencies": {
		"@effect/vitest": "catalog:",
		"@shivaedev/effect-prisma": "workspace:*",
		"@shivaedev/effect-trpc": "workspace:*",
		"@trpc/server": "catalog:",
		"better-auth": "catalog:",
		"effect": "catalog:"
	},
	"peerDependenciesMeta": {
		"@effect/vitest": {
			"optional": true
		},
		"@shivaedev/effect-prisma": {
			"optional": true
		},
		"@shivaedev/effect-trpc": {
			"optional": true
		},
		"@trpc/server": {
			"optional": true
		},
		"better-auth": {
			"optional": true
		}
	},
	"engines": {
		"node": ">=24"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	}
}
