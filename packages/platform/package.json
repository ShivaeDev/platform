{
	"name": "@shivaedev/platform",
	"version": "0.34.0",
	"description": "Opinionated Effect application infrastructure for ShivaeDev services",
	"homepage": "https://github.com/ShivaeDev/platform/tree/main/packages/platform#readme",
	"bugs": {
		"url": "https://github.com/ShivaeDev/platform/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ShivaeDev/platform.git",
		"directory": "packages/platform"
	},
	"license": "MIT",
	"type": "module",
	"exports": {
		"./package.json": "./package.json"
	},
	"files": [
		"CHANGELOG.md",
		"README.md"
	],
	"dependencies": {
		"@shivaedev/access": "workspace:*",
		"@shivaedev/contract": "workspace:*",
		"@shivaedev/errors": "workspace:*",
		"@shivaedev/http": "workspace:*",
		"@shivaedev/identity": "workspace:*",
		"@shivaedev/local-postgres": "workspace:*",
		"@shivaedev/server": "workspace:*",
		"@shivaedev/sql": "workspace:*",
		"@shivaedev/types": "workspace:*"
	},
	"peerDependencies": {
		"@effect/platform-node": "catalog:",
		"@effect/sql-pg": "catalog:",
		"@effect/vitest": "catalog:",
		"better-auth": "catalog:",
		"effect": "catalog:",
		"pg": "catalog:"
	},
	"peerDependenciesMeta": {
		"@effect/platform-node": {
			"optional": true
		},
		"@effect/sql-pg": {
			"optional": true
		},
		"@effect/vitest": {
			"optional": true
		},
		"better-auth": {
			"optional": true
		},
		"pg": {
			"optional": true
		}
	},
	"engines": {
		"node": ">=24"
