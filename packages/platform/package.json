{
	"name": "@shivaedev/platform",
	"version": "0.6.0",
	"description": "Opinionated Effect application infrastructure for ShivaeDev services",
	"homepage": "https://github.com/ShivaeDev/platform/tree/main/packages/platform#readme",
	"bugs": {
		"url": "https://github.com/ShivaeDev/platform/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ShivaeDev/platform.git",
		"directory": "packages/platform"
	},
	"license": "MIT",
	"sideEffects": false,
	"type": "module",
	"imports": {
		"#test/*": "./test/*",
		"#*.ts": {
			"source": "./src/*.ts",
			"types": "./dist/*.d.ts",
			"default": "./dist/*.js"
		}
	},
	"exports": {
		"./*.ts": {
			"types": "./dist/*.d.ts",
			"source": "./src/*.ts",
			"import": "./dist/*.js",
			"default": "./dist/*.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"src",
		"!src/**/*.test.ts",
		"!src/**/*.spec.ts",
		"!src/**/test-support",
		"CHANGELOG.md",
		"README.md"
	],
	"scripts": {
		"build": "node --eval \"import('node:fs').then(({ rmSync }) => rmSync('dist', { force: true, recursive: true }))\" && tsc6 --project tsconfig.build.json",
		"ready": "pnpm typecheck && pnpm test && pnpm build",
		"test": "vitest run",
		"typecheck": "tsc --noEmit"
	},
	"devDependencies": {
		"@effect/vitest": "catalog:",
		"@prisma-next/adapter-postgres": "catalog:",
		"@prisma-next/contract": "catalog:",
		"@prisma-next/postgres": "catalog:",
		"@prisma-next/sql-contract": "catalog:",
		"@prisma-next/sql-orm-client": "catalog:",
		"@prisma-next/target-postgres": "catalog:",
		"@shivaedev/effect-prisma": "workspace:*",
		"@shivaedev/effect-trpc": "workspace:*",
		"@shivaedev/quality": "workspace:*",
		"@shivaedev/types": "workspace:*",
		"@trpc/client": "catalog:",
		"@trpc/server": "catalog:",
		"@types/node": "catalog:",
		"@typescript/native": "catalog:",
		"better-auth": "catalog:",
		"effect": "catalog:",
		"superjson": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	},
	"peerDependencies": {
		"@effect/vitest": "catalog:",
		"@prisma-next/sql-orm-client": "catalog:",
		"@shivaedev/effect-prisma": "workspace:*",
		"@shivaedev/effect-trpc": "workspace:*",
		"@trpc/server": "catalog:",
		"better-auth": "catalog:",
		"effect": "catalog:"
	},
	"peerDependenciesMeta": {
		"@effect/vitest": {
			"optional": true
		},
		"@prisma-next/sql-orm-client": {
			"optional": true
		},
		"@shivaedev/effect-prisma": {
			"optional": true
		},
		"@shivaedev/effect-trpc": {
			"optional": true
		},
		"@trpc/server": {
			"optional": true
		},
		"better-auth": {
			"optional": true
		}
	},
	"engines": {
		"node": ">=24"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	}
}
