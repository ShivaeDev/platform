// use prisma-next

types {
  Id = String @db.Uuid
}

model AuthUser {
  id            Id       @id(map: "AuthUser_pkey")
  email         String   @unique(map: "AuthUser_email_key")
  name          String
  emailVerified Boolean  @default(false) @map("email_verified")
  image         String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @default(now()) @map("updated_at")

  @@map("auth_user")
}
