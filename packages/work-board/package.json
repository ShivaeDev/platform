{
	"name": "@shivaedev/work-board",
	"version": "0.12.0",
	"description": "Serve a folder of markdown files as a live local page that updates in place when a file changes",
	"homepage": "https://github.com/ShivaeDev/platform/tree/main/packages/work-board#readme",
	"bugs": {
		"url": "https://github.com/ShivaeDev/platform/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ShivaeDev/platform.git",
		"directory": "packages/work-board"
	},
	"license": "MIT",
	"sideEffects": false,
	"type": "module",
	"imports": {
		"#test/*": "./src/test-support/*",
		"#*.ts": {
			"source": "./src/*.ts",
			"types": "./dist/*.d.ts",
			"default": "./dist/*.js"
		},
		"#*.tsx": {
			"source": "./src/*.tsx",
			"types": "./dist/*.d.ts",
			"default": "./dist/*.js"
		},
		"#*.css": "./src/*.css"
	},
	"exports": {
		"./*.ts": {
			"types": "./dist/*.d.ts",
			"source": "./src/*.ts",
			"import": "./dist/*.js",
			"default": "./dist/*.js"
		},
		"./package.json": "./package.json",
		"./browser/react/*": null,
		"./browser/entry.ts": null,
		"./browser/fieldFeedback.ts": null,
		"./browser/reconcile/*": null,
		"./browser/legacyRuntime.ts": null,
		"./browser/session.ts": null,
		"./browser/handoffs/*": null,
		"./browser/responses/*": null,
		"./browser/handoffs/schema.ts": {
			"types": "./dist/browser/handoffs/schema.d.ts",
			"source": "./src/browser/handoffs/schema.ts",
			"import": "./dist/browser/handoffs/schema.js",
			"default": "./dist/browser/handoffs/schema.js"
		},
		"./browser/responses/schema.ts": {
			"types": "./dist/browser/responses/schema.d.ts",
			"source": "./src/browser/responses/schema.ts",
			"import": "./dist/browser/responses/schema.js",
			"default": "./dist/browser/responses/schema.js"
		},
		"./browser/responses/Prompt.ts": {
			"types": "./dist/browser/responses/Prompt.d.ts",
			"source": "./src/browser/responses/Prompt.ts",
			"import": "./dist/browser/responses/Prompt.js",
			"default": "./dist/browser/responses/Prompt.js"
		},
		"./browser/responses/answerBody.ts": {
			"types": "./dist/browser/responses/answerBody.d.ts",
			"source": "./src/browser/responses/answerBody.ts",
			"import": "./dist/browser/responses/answerBody.js",
			"default": "./dist/browser/responses/answerBody.js"
		}
	},
	"bin": {
		"work-board": "./dist/cli.js"
	},
	"files": [
		"dist",
		"src",
		"assets",
		"!src/**/*.test.ts",
		"!src/**/*.test.tsx",
		"!src/**/*.spec.ts",
		"!src/**/*.spec.tsx",
		"!src/**/test-support",
		"docs",
		"CHANGELOG.md",
		"README.md"
	],
	"scripts": {
		"build": "node --eval \"import('node:fs').then(({ rmSync }) => rmSync('dist', { force: true, recursive: true }))\" && tsc --project tsconfig.build.json && pnpm build:browser",
		"build:browser": "esbuild src/browser/entry.ts --bundle --platform=browser --format=esm --conditions=source --minify --banner:js='/* @shivaedev/work-board native browser bundle */' --outfile=assets/native.js && esbuild src/responses/agent-cli.ts --bundle --platform=node --format=esm --conditions=source --minify --outfile=assets/agent.js && vite build",
		"ready": "pnpm typecheck && pnpm test && pnpm build",
		"test": "pnpm test:prepare && vitest run",
		"test:prepare": "pnpm build:browser",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@shivaedev/effect-contract": "workspace:*",
		"@shivaedev/effect-service": "workspace:*",
		"@shivaedev/platform": "workspace:*",
		"mdast-util-directive": "catalog:",
		"mermaid": "catalog:",
		"react": "catalog:",
		"react-dom": "catalog:",
		"react-markdown": "catalog:",
		"rehype-raw": "catalog:",
		"remark-directive": "catalog:",
		"remark-gfm": "catalog:",
		"remark-parse": "catalog:",
		"shiki": "catalog:",
		"unified": "catalog:",
		"unist-util-visit": "catalog:",
		"yaml": "catalog:"
	},
	"devDependencies": {
		"@effect/atom-react": "catalog:",
		"@effect/platform-node": "catalog:",
		"@effect/platform-node-shared": "catalog:",
		"@shivaedev/effect-form": "workspace:*",
		"@shivaedev/effect-react": "workspace:*",
		"@shivaedev/effect-test": "workspace:*",
		"@shivaedev/quality": "workspace:*",
		"@tailwindcss/vite": "catalog:",
		"@tanstack/react-router": "catalog:",
		"@types/hast": "catalog:",
		"@types/mdast": "catalog:",
		"@types/node": "catalog:",
		"@types/react": "catalog:",
		"@types/react-dom": "catalog:",
		"@typescript/native": "catalog:",
		"@vitejs/plugin-react": "catalog:",
		"class-variance-authority": "catalog:",
		"clsx": "catalog:",
		"effect": "catalog:",
		"esbuild": "catalog:",
		"happy-dom": "catalog:",
		"lucide-react": "catalog:",
		"tailwind-merge": "catalog:",
		"tailwindcss": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vitest": "catalog:"
	},
	"peerDependencies": {
		"@effect/platform-node": "catalog:",
		"@effect/platform-node-shared": "catalog:",
		"effect": "catalog:"
	},
	"engines": {
		"node": ">=24"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	}
}
