{
	"name": "@shivaedev/work-board",
	"version": "0.18.0",
	"description": "Serve a folder of markdown files as a live local page that updates in place when a file changes",
	"homepage": "https://github.com/ShivaeDev/platform/tree/main/packages/work-board#readme",
	"bugs": {
		"url": "https://github.com/ShivaeDev/platform/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ShivaeDev/platform.git",
		"directory": "packages/work-board"
	},
	"license": "MIT",
	"sideEffects": false,
	"type": "module",
	"imports": {
		"#test/*": "./src/test-support/*",
		"#*.ts": {
			"source": "./src/*.ts",
			"types": "./dist/*.d.ts",
			"default": "./dist/*.js"
		},
		"#*.tsx": {
			"source": "./src/*.tsx",
			"types": "./dist/*.d.ts",
			"default": "./dist/*.js"
		},
		"#*.css": "./src/*.css",
		"#client/react/components/ui/button": {
			"source": "./src/client/react/components/ui/button.tsx",
			"types": "./dist/client/react/components/ui/button.d.ts",
			"default": "./dist/client/react/components/ui/button.js"
		}
	},
	"exports": {
		"./*.ts": {
			"source": "./src/*.ts",
			"types": "./dist/*.d.ts",
			"default": "./dist/*.js"
		},
		"./client/*": null,
		"./client/client.ts": {
			"source": "./src/client/client.ts",
			"types": "./dist/client/client.d.ts",
			"default": "./dist/client/client.js"
		},
		"./client/document/View.ts": {
			"source": "./src/client/document/View.ts",
			"types": "./dist/client/document/View.d.ts",
			"default": "./dist/client/document/View.js"
		},
		"./package.json": "./package.json"
	},
	"bin": {
		"work-board": "./dist/server/cli.js"
	},
	"files": [
		"dist",
		"src",
		"assets",
		"!src/**/*.test.ts",
		"!src/**/*.test.tsx",
		"!src/**/*.spec.ts",
		"!src/**/*.spec.tsx",
		"!src/**/test-support",
		"docs",
		"CHANGELOG.md",
		"README.md"
	],
	"scripts": {
		"build": "node --eval \"import('node:fs').then(({ rmSync }) => rmSync('dist', { force: true, recursive: true }))\" && tsc --project tsconfig.build.json && pnpm build:browser",
		"build:browser": "esbuild src/server/responses/agent-cli.ts --bundle --platform=node --format=esm --conditions=source --minify --external:yaml --outfile=assets/agent.js && vite build",
		"ready": "pnpm typecheck && pnpm test && pnpm build",
		"test": "pnpm test:prepare && vitest run",
		"test:prepare": "pnpm build:browser",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@shivaedev/effect-contract": "workspace:*",
		"@shivaedev/effect-service": "workspace:*",
		"@shivaedev/platform": "workspace:*",
		"mdast-util-directive": "catalog:",
		"mermaid": "catalog:",
		"react": "catalog:",
		"react-dom": "catalog:",
		"react-markdown": "catalog:",
		"rehype-raw": "catalog:",
		"remark-directive": "catalog:",
		"remark-gfm": "catalog:",
		"remark-parse": "catalog:",
		"shiki": "catalog:",
		"unified": "catalog:",
		"unist-util-visit": "catalog:",
		"yaml": "catalog:"
	},
	"devDependencies": {
		"@base-ui/react": "catalog:",
		"@effect/atom-react": "catalog:",
		"@effect/platform-node": "catalog:",
		"@effect/platform-node-shared": "catalog:",
		"@fontsource-variable/geist": "catalog:",
		"@fontsource-variable/geist-mono": "catalog:",
		"@shivaedev/effect-form": "workspace:*",
		"@shivaedev/effect-react": "workspace:*",
		"@shivaedev/effect-test": "workspace:*",
		"@shivaedev/quality": "workspace:*",
		"@shivaedev/test-story": "workspace:*",
		"@shivaedev/work-board-plugin": "workspace:*",
		"@tailwindcss/vite": "catalog:",
		"@tanstack/react-router": "catalog:",
		"@types/hast": "catalog:",
		"@types/mdast": "catalog:",
		"@types/node": "catalog:",
		"@types/react": "catalog:",
		"@types/react-dom": "catalog:",
		"@typescript/native": "catalog:",
		"@vitejs/plugin-react": "catalog:",
		"class-variance-authority": "catalog:",
		"cn": "catalog:",
		"effect": "catalog:",
		"esbuild": "catalog:",
		"happy-dom": "catalog:",
		"lucide-react": "catalog:",
		"tailwindcss": "catalog:",
		"tw-animate-css": "catalog:",
		"typescript": "catalog:compiler-api",
		"vite": "catalog:",
		"vitest": "catalog:"
	},
	"peerDependencies": {
		"@effect/platform-node": "catalog:",
		"@effect/platform-node-shared": "catalog:",
		"effect": "catalog:"
	},
	"engines": {
		"node": ">=24"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	}
}
