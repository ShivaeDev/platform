{
	"name": "@shivaedev/work-board",
	"version": "0.1.0",
	"description": "Serve a folder of markdown files as a live local page that updates in place when a file changes",
	"type": "module",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ShivaeDev/platform.git",
		"directory": "packages/work-board"
	},
	"homepage": "https://github.com/ShivaeDev/platform/tree/main/packages/work-board#readme",
	"bugs": {
		"url": "https://github.com/ShivaeDev/platform/issues"
	},
	"engines": {
		"node": ">=24"
	},
	"sideEffects": false,
	"bin": {
		"work-board": "./dist/cli.js"
	},
	"files": [
		"dist",
		"src",
		"CHANGELOG.md",
		"README.md"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"source": "./src/index.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"scripts": {
		"build": "node --eval \"import('node:fs').then(({ rmSync }) => rmSync('dist', { force: true, recursive: true }))\" && tsc6 --project tsconfig.build.json",
		"check": "biome check .",
		"test": "vitest run",
		"test:package": "node scripts/test-package.mjs",
		"typecheck": "tsc --noEmit",
		"typecheck:compat": "tsc6 --noEmit",
		"ready": "pnpm check && pnpm typecheck && pnpm typecheck:compat && pnpm test && pnpm build && pnpm test:package"
	},
	"dependencies": {
		"mermaid": "catalog:",
		"satteri": "catalog:",
		"shiki": "catalog:"
	},
	"peerDependencies": {
		"@effect/platform-node": "catalog:",
		"effect": "catalog:"
	},
	"devDependencies": {
		"@effect/platform-node": "catalog:",
		"@types/hast": "catalog:",
		"@types/mdast": "catalog:",
		"@types/node": "catalog:",
		"@typescript/native": "catalog:",
		"effect": "catalog:",
		"happy-dom": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
