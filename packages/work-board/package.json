{
	"name": "@shivaedev/work-board",
	"version": "0.10.0",
	"description": "Serve a folder of markdown files as a live local page that updates in place when a file changes",
	"homepage": "https://github.com/ShivaeDev/platform/tree/main/packages/work-board#readme",
	"bugs": {
		"url": "https://github.com/ShivaeDev/platform/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ShivaeDev/platform.git",
		"directory": "packages/work-board"
	},
	"license": "MIT",
	"sideEffects": false,
	"type": "module",
	"imports": {
		"#test/*": "./src/test-support/*",
		"#*.ts": {
			"source": "./src/*.ts",
			"types": "./dist/*.d.ts",
			"default": "./dist/*.js"
		}
	},
	"exports": {
		"./*.ts": {
			"types": "./dist/*.d.ts",
			"source": "./src/*.ts",
			"import": "./dist/*.js",
			"default": "./dist/*.js"
		},
		"./package.json": "./package.json"
	},
	"bin": {
		"work-board": "./dist/cli.js"
	},
	"files": [
		"dist",
		"src",
		"assets",
		"!src/**/*.test.ts",
		"!src/**/*.spec.ts",
		"!src/**/test-support",
		"CHANGELOG.md",
		"README.md"
	],
	"scripts": {
		"build": "node --eval \"import('node:fs').then(({ rmSync }) => rmSync('dist', { force: true, recursive: true }))\" && tsc --project tsconfig.build.json && pnpm build:browser",
		"build:browser": "esbuild src/browser/entry.ts --bundle --platform=browser --format=esm --conditions=source --minify --outfile=assets/native.js && esbuild src/responses/agent-cli.ts --bundle --platform=node --format=esm --conditions=source --minify --outfile=assets/agent.js",
		"ready": "pnpm typecheck && pnpm test && pnpm build",
		"test": "pnpm test:prepare && vitest run",
		"test:prepare": "pnpm build:browser",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@shivaedev/effect-contract": "workspace:*",
		"mdast-util-directive": "catalog:",
		"mermaid": "catalog:",
		"react": "catalog:",
		"react-dom": "catalog:",
		"react-markdown": "catalog:",
		"rehype-raw": "catalog:",
		"remark-directive": "catalog:",
		"remark-gfm": "catalog:",
		"remark-parse": "catalog:",
		"shiki": "catalog:",
		"unified": "catalog:",
		"unist-util-visit": "catalog:",
		"yaml": "catalog:"
	},
	"devDependencies": {
		"@effect/platform-node": "catalog:",
		"@effect/platform-node-shared": "catalog:",
		"@shivaedev/quality": "workspace:*",
		"@types/hast": "catalog:",
		"@types/mdast": "catalog:",
		"@types/node": "catalog:",
		"@types/react": "catalog:",
		"@types/react-dom": "catalog:",
		"@typescript/native": "catalog:",
		"effect": "catalog:",
		"esbuild": "catalog:",
		"happy-dom": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	},
	"peerDependencies": {
		"@effect/platform-node": "catalog:",
		"@effect/platform-node-shared": "catalog:",
		"effect": "catalog:"
	},
	"engines": {
		"node": ">=24"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	}
}
