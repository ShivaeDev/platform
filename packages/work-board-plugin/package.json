{
	"name": "@shivaedev/work-board-plugin",
	"version": "0.0.0",
	"private": true,
	"description": "The Work Board inside Claude Code: a pane, a band above the prompt, decision toasts and read-only board tools",
	"license": "MIT",
	"type": "module",
	"imports": {
		"#test/*": "./src/test-support/*",
		"#*.ts": "./src/*.ts",
		"#types/*": "./types/*"
	},
	"exports": {
		"./*.ts": {
			"source": "./src/*.ts",
			"types": "./dist/*.d.ts",
			"default": "./dist/*.js"
		}
	},
	"scripts": {
		"build": "tsc --project tsconfig.build.json",
		"test": "vitest run",
		"typecheck": "tsc --noEmit"
	},
	"devDependencies": {
		"@shivaedev/quality": "workspace:*",
		"@shivaedev/test-story": "workspace:*",
		"@types/node": "catalog:",
		"effect": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	},
	"engines": {
		"node": ">=24"
	}
}
