{
	"compilerOptions": {
		"target": "ESNext",
		"lib": ["ESNext", "DOM", "DOM.Iterable"],
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"strict": true,
		"stableTypeOrdering": true,
		"noEmit": true,
		"skipLibCheck": true,
		"types": ["node"],
		"verbatimModuleSyntax": true
	},
	"include": ["src", "test"]
}
