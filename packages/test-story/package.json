{
	"name": "@shivaedev/test-story",
	"version": "0.26.0",
	"description": "Tests that read like stories over the real engine: a story kit per engine with its own it, traits per feature, and a failure that prints the story, where it stopped and the engine's state",
	"homepage": "https://github.com/ShivaeDev/platform/tree/main/packages/test-story#readme",
	"bugs": {
		"url": "https://github.com/ShivaeDev/platform/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ShivaeDev/platform.git",
		"directory": "packages/test-story"
	},
	"license": "MIT",
	"sideEffects": false,
	"type": "module",
	"imports": {
		"#test/*": "./src/test-support/*",
		"#*.ts": {
			"source": "./src/server/*.ts",
			"types": "./dist/server/*.d.ts",
			"default": "./dist/server/*.js"
		}
	},
	"exports": {
		"./*.ts": {
			"source": "./src/*.ts",
			"types": "./dist/*.d.ts",
			"default": "./dist/*.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"src",
		"!src/**/*.test.ts",
		"!src/**/*.test.tsx",
		"!src/**/*.spec.ts",
		"!src/**/*.spec.tsx",
		"!src/**/test-support",
		"CHANGELOG.md",
		"README.md"
	],
	"scripts": {
		"build": "node --eval \"import('node:fs').then(({ rmSync }) => rmSync('dist', { force: true, recursive: true }))\" && tsc --project tsconfig.build.json",
		"ready": "pnpm typecheck && pnpm test && pnpm build",
		"test": "vitest run --configLoader native",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@shivaedev/contract": "workspace:*",
		"@shivaedev/test": "workspace:*",
		"@shivaedev/test-sql": "workspace:*",
		"dom-accessibility-api": "catalog:"
	},
	"devDependencies": {
		"@effect/atom-react": "catalog:",
		"@effect/platform-node": "catalog:",
		"@effect/vitest": "catalog:",
		"@shivaedev/quality": "workspace:*",
		"@types/node": "catalog:",
		"@types/react": "catalog:",
		"@types/react-dom": "catalog:",
		"effect": "catalog:",
		"happy-dom": "catalog:",
		"react": "catalog:",
		"react-dom": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	},
	"peerDependencies": {
		"@effect/atom-react": "catalog:",
		"@effect/platform-node": "catalog:",
		"@effect/sql-pg": "catalog:",
		"@effect/vitest": "catalog:",
		"effect": "catalog:",
		"happy-dom": "catalog:",
		"react": "catalog:",
		"react-dom": "catalog:",
		"vitest": "catalog:"
	},
	"peerDependenciesMeta": {
		"@effect/atom-react": {
			"optional": true
		},
		"@effect/sql-pg": {
			"optional": true
		},
		"happy-dom": {
			"optional": true
		},
		"react": {
			"optional": true
		},
		"react-dom": {
			"optional": true
		}
	},
	"engines": {
		"node": ">=24"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	}
}
