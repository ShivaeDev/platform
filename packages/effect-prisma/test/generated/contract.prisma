// use prisma-next
// Contract inferred from the live database schema. Edit as needed, then run `prisma-next contract emit`.

types {
  Id = String @db.Uuid
  CreatedAt = DateTime @db.Timestamp(6)
  VerifiedAt = DateTime @db.Timestamptz(6)
}

model User {
  id            Id     @id(map: "User_pkey")
  email         String @unique(map: "User_email_key")
  name          String
  createdAt     CreatedAt @default(now()) @map("created_at")
  verifiedAt    VerifiedAt? @map("verified_at")
  posts         Post[] @relation("PostAuthor")
  reviewedPosts Post[] @relation("PostReviewer")
}

model Post {
  id         Id     @id(map: "Post_pkey")
  title      String
  userId     Id     @map("user_id")
  user       User   @relation("PostAuthor", fields: [userId], references: [id])
  reviewerId Id?    @map("reviewer_id")
  reviewer   User?  @relation("PostReviewer", fields: [reviewerId], references: [id])

  @@index([userId], map: "Post_user_id_idx")
  @@index([reviewerId], map: "Post_reviewer_id_idx")
}
