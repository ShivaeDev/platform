{
	"name": "@shivaedev/effect-prisma",
	"version": "0.7.1",
	"description": "Effect-native PostgreSQL queries and transactions for Prisma Next",
	"homepage": "https://github.com/ShivaeDev/platform/tree/main/packages/effect-prisma#readme",
	"bugs": {
		"url": "https://github.com/ShivaeDev/platform/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ShivaeDev/platform.git",
		"directory": "packages/effect-prisma"
	},
	"license": "MIT",
	"sideEffects": false,
	"type": "module",
	"imports": {
		"#test/*": "./test/*",
		"#*.ts": {
			"source": "./src/*.ts",
			"types": "./dist/*.d.ts",
			"default": "./dist/*.js"
		}
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"source": "./src/index.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./sqlite": {
			"types": "./dist/sqlite.d.ts",
			"source": "./src/sqlite.ts",
			"import": "./dist/sqlite.js",
			"default": "./dist/sqlite.js"
		},
		"./testing": {
			"types": "./dist/testing.d.ts",
			"source": "./src/testing.ts",
			"import": "./dist/testing.js",
			"default": "./dist/testing.js"
		},
		"./package.json": "./package.json"
	},
	"bin": {
		"effect-prisma-normalize": "./dist/bin/normalize-contract.js"
	},
	"files": [
		"dist",
		"src",
		"CHANGELOG.md",
		"README.md"
	],
	"scripts": {
		"build": "node --eval \"import('node:fs').then(({ rmSync }) => rmSync('dist', { force: true, recursive: true }))\" && tsc6 --project tsconfig.build.json",
		"ready": "pnpm typecheck && pnpm test && pnpm build",
		"test": "vitest run",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@prisma-next/contract": "catalog:",
		"@prisma-next/postgres": "catalog:",
		"@prisma-next/sql-contract": "catalog:",
		"@prisma-next/sql-orm-client": "catalog:",
		"@prisma-next/sql-relational-core": "catalog:",
		"@prisma-next/sql-runtime": "catalog:",
		"@prisma-next/sqlite": "catalog:",
		"@shivaedev/effect-test": "workspace:*"
	},
	"devDependencies": {
		"@effect/vitest": "catalog:",
		"@prisma-next/adapter-postgres": "catalog:",
		"@prisma-next/adapter-sqlite": "catalog:",
		"@prisma-next/cli": "catalog:",
		"@prisma-next/target-postgres": "catalog:",
		"@prisma-next/target-sqlite": "catalog:",
		"@shivaedev/quality": "workspace:*",
		"@types/node": "catalog:",
		"@types/pg": "catalog:",
		"@typescript/native": "catalog:",
		"effect": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	},
	"peerDependencies": {
		"@effect/vitest": "catalog:",
		"effect": "catalog:"
	},
	"peerDependenciesMeta": {
		"@effect/vitest": {
			"optional": true
		}
	},
	"engines": {
		"node": ">=24"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	}
}
