{
	"name": "@shivaedev/effect-contract",
	"version": "0.5.0",
	"description": "Typed query and command contracts over native Effect RPC and reactivity",
	"homepage": "https://github.com/ShivaeDev/platform/tree/main/packages/effect-contract#readme",
	"bugs": {
		"url": "https://github.com/ShivaeDev/platform/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ShivaeDev/platform.git",
		"directory": "packages/effect-contract"
	},
	"license": "MIT",
	"sideEffects": false,
	"type": "module",
	"imports": {
		"#test/*": "./src/test-support/*",
		"#*.ts": {
			"source": "./src/*.ts",
			"types": "./dist/*.d.ts",
			"default": "./dist/*.js"
		}
	},
	"exports": {
		"./package.json": "./package.json",
		"./bind.ts": {
			"types": "./dist/bind.d.ts",
			"source": "./src/bind.ts",
			"import": "./dist/bind.js",
			"default": "./dist/bind.js"
		},
		"./contract.ts": {
			"types": "./dist/contract.d.ts",
			"source": "./src/contract.ts",
			"import": "./dist/contract.js",
			"default": "./dist/contract.js"
		},
		"./keys.ts": {
			"types": "./dist/keys.d.ts",
			"source": "./src/keys.ts",
			"import": "./dist/keys.js",
			"default": "./dist/keys.js"
		},
		"./live.ts": {
			"types": "./dist/live.d.ts",
			"source": "./src/live.ts",
			"import": "./dist/live.js",
			"default": "./dist/live.js"
		},
		"./makeLiveServer.ts": {
			"types": "./dist/makeLiveServer.d.ts",
			"source": "./src/makeLiveServer.ts",
			"import": "./dist/makeLiveServer.js",
			"default": "./dist/makeLiveServer.js"
		},
		"./operation.ts": {
			"types": "./dist/operation.d.ts",
			"source": "./src/operation.ts",
			"import": "./dist/operation.js",
			"default": "./dist/operation.js"
		},
		"./rejection.ts": {
			"types": "./dist/rejection.d.ts",
			"source": "./src/rejection.ts",
			"import": "./dist/rejection.js",
			"default": "./dist/rejection.js"
		},
		"./resume.ts": {
			"types": "./dist/resume.d.ts",
			"source": "./src/resume.ts",
			"import": "./dist/resume.js",
			"default": "./dist/resume.js"
		}
	},
	"files": [
		"dist",
		"src",
		"!src/**/*.test.ts",
		"!src/**/*.spec.ts",
		"!src/**/test-support",
		"docs",
		"CHANGELOG.md",
		"README.md"
	],
	"scripts": {
		"build": "node --eval \"import('node:fs').then(({ rmSync }) => rmSync('dist', { force: true, recursive: true }))\" && tsc --project tsconfig.build.json",
		"ready": "pnpm typecheck && pnpm test && pnpm build",
		"test": "vitest run",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@shivaedev/types": "workspace:*"
	},
	"devDependencies": {
		"@effect/platform-node": "catalog:",
		"@effect/vitest": "catalog:",
		"@shivaedev/effect-test": "workspace:*",
		"@shivaedev/quality": "workspace:*",
		"@types/node": "catalog:",
		"@typescript/native": "catalog:",
		"effect": "catalog:",
		"esbuild": "catalog:",
		"happy-dom": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	},
	"peerDependencies": {
		"effect": "catalog:"
	},
	"engines": {
		"node": ">=24"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	}
}
