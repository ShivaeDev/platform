{
	"name": "@shivaedev/heavy-lock",
	"version": "0.2.0",
	"description": "Machine-wide lock that runs heavy commands one at a time across repositories",
	"type": "module",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ShivaeDev/platform.git",
		"directory": "packages/heavy-lock"
	},
	"homepage": "https://github.com/ShivaeDev/platform/tree/main/packages/heavy-lock#readme",
	"bugs": {
		"url": "https://github.com/ShivaeDev/platform/issues"
	},
	"engines": {
		"node": ">=24"
	},
	"sideEffects": false,
	"bin": {
		"heavy-lock": "./dist/cli.js"
	},
	"files": [
		"dist",
		"src",
		"CHANGELOG.md",
		"README.md"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"source": "./src/index.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"scripts": {
		"build": "node --eval \"import('node:fs').then(({ rmSync }) => rmSync('dist', { force: true, recursive: true }))\" && tsc6 --project tsconfig.build.json",
		"check": "biome check .",
		"test": "vitest run",
		"typecheck": "tsc --noEmit",
		"ready": "pnpm check && pnpm typecheck && pnpm test && pnpm build"
	},
	"peerDependencies": {
		"@effect/platform-node": "catalog:",
		"@effect/platform-node-shared": "catalog:",
		"effect": "catalog:"
	},
	"devDependencies": {
		"@effect/platform-node": "catalog:",
		"@effect/platform-node-shared": "catalog:",
		"@effect/vitest": "catalog:",
		"@shivaedev/quality": "workspace:*",
		"@types/node": "catalog:",
		"@typescript/native": "catalog:",
		"effect": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
