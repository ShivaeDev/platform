{
	"name": "@shivaedev/effect-react",
	"version": "0.3.0",
	"description": "React query, action, editor and session hooks for native Effect atoms",
	"homepage": "https://github.com/ShivaeDev/platform/tree/main/packages/effect-react#readme",
	"bugs": {
		"url": "https://github.com/ShivaeDev/platform/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ShivaeDev/platform.git",
		"directory": "packages/effect-react"
	},
	"license": "MIT",
	"sideEffects": false,
	"type": "module",
	"imports": {
		"#test/*": "./src/test-support/*",
		"#*.ts": {
			"source": "./src/*.ts",
			"types": "./dist/*.d.ts",
			"default": "./dist/*.js"
		},
		"#create.ts": {
			"source": "./src/client/create.ts",
			"types": "./dist/client/create.d.ts",
			"default": "./dist/client/create.js"
		},
		"#editor.ts": {
			"source": "./src/client/editor.ts",
			"types": "./dist/client/editor.d.ts",
			"default": "./dist/client/editor.js"
		},
		"#result-state.ts": {
			"source": "./src/client/resultState.ts",
			"types": "./dist/client/resultState.d.ts",
			"default": "./dist/client/resultState.js"
		},
		"#save-state.ts": {
			"source": "./src/client/saveState.ts",
			"types": "./dist/client/saveState.d.ts",
			"default": "./dist/client/saveState.js"
		},
		"#session-boundary.ts": {
			"source": "./src/client/sessionBoundary.ts",
			"types": "./dist/client/sessionBoundary.d.ts",
			"default": "./dist/client/sessionBoundary.js"
		},
		"#testing.ts": {
			"source": "./src/client/testing.ts",
			"types": "./dist/client/testing.d.ts",
			"default": "./dist/client/testing.js"
		}
	},
	"exports": {
		"./package.json": "./package.json",
		"./router.ts": {
			"types": "./dist/loadQuery.d.ts",
			"source": "./src/loadQuery.ts",
			"import": "./dist/loadQuery.js",
			"default": "./dist/loadQuery.js"
		},
		"./loadQuery.ts": null,
		"./create.ts": {
			"types": "./dist/client/create.d.ts",
			"source": "./src/client/create.ts",
			"import": "./dist/client/create.js",
			"default": "./dist/client/create.js"
		},
		"./editor.ts": {
			"types": "./dist/client/editor.d.ts",
			"source": "./src/client/editor.ts",
			"import": "./dist/client/editor.js",
			"default": "./dist/client/editor.js"
		},
		"./field-rejection.ts": {
			"types": "./dist/field-rejection.d.ts",
			"source": "./src/field-rejection.ts",
			"import": "./dist/field-rejection.js",
			"default": "./dist/field-rejection.js"
		},
		"./result-state.ts": {
			"types": "./dist/client/resultState.d.ts",
			"source": "./src/client/resultState.ts",
			"import": "./dist/client/resultState.js",
			"default": "./dist/client/resultState.js"
		},
		"./resume-signal.ts": {
			"types": "./dist/resume-signal.d.ts",
			"source": "./src/resume-signal.ts",
			"import": "./dist/resume-signal.js",
			"default": "./dist/resume-signal.js"
		},
		"./save-state.ts": {
			"types": "./dist/client/saveState.d.ts",
			"source": "./src/client/saveState.ts",
			"import": "./dist/client/saveState.js",
			"default": "./dist/client/saveState.js"
		},
		"./session-boundary.ts": {
			"types": "./dist/client/sessionBoundary.d.ts",
			"source": "./src/client/sessionBoundary.ts",
			"import": "./dist/client/sessionBoundary.js",
			"default": "./dist/client/sessionBoundary.js"
		},
		"./submission.ts": {
			"types": "./dist/submission.d.ts",
			"source": "./src/submission.ts",
			"import": "./dist/submission.js",
			"default": "./dist/submission.js"
		},
		"./testing.ts": {
			"types": "./dist/client/testing.d.ts",
			"source": "./src/client/testing.ts",
			"import": "./dist/client/testing.js",
			"default": "./dist/client/testing.js"
		}
	},
	"files": [
		"dist",
		"docs",
		"src",
		"!src/**/*.test.ts",
		"!src/**/*.test.tsx",
		"!src/**/*.spec.ts",
		"!src/**/*.spec.tsx",
		"!src/**/test-support",
		"CHANGELOG.md",
		"README.md"
	],
	"scripts": {
		"build": "node --eval \"import('node:fs').then(({ rmSync }) => rmSync('dist', { force: true, recursive: true }))\" && tsc --project tsconfig.build.json",
		"ready": "pnpm typecheck && pnpm test && pnpm build",
		"test": "vitest run",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@shivaedev/effect-contract": "workspace:*",
		"@shivaedev/effect-form": "workspace:*"
	},
	"devDependencies": {
		"@effect/atom-react": "catalog:",
		"@effect/platform-node": "catalog:",
		"@effect/sql-pg": "catalog:",
		"@effect/sql-sqlite-node": "catalog:",
		"@shivaedev/effect-pg-boss": "workspace:*",
		"@shivaedev/effect-service": "workspace:*",
		"@shivaedev/effect-sql": "workspace:*",
		"@shivaedev/effect-test": "workspace:*",
		"@shivaedev/local-postgres": "workspace:*",
		"@shivaedev/platform": "workspace:*",
		"@shivaedev/quality": "workspace:*",
		"@shivaedev/test-story": "workspace:*",
		"@tanstack/react-router": "catalog:",
		"@types/node": "catalog:",
		"@types/react": "catalog:",
		"@types/react-dom": "catalog:",
		"@typescript/native": "catalog:",
		"effect": "catalog:",
		"happy-dom": "catalog:",
		"react": "catalog:",
		"react-dom": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	},
	"peerDependencies": {
		"@effect/atom-react": "catalog:",
		"@tanstack/react-router": "catalog:",
		"effect": "catalog:",
		"react": "catalog:",
		"react-dom": "catalog:",
		"vitest": "catalog:"
	},
	"peerDependenciesMeta": {
		"@tanstack/react-router": {
			"optional": true
		},
		"react-dom": {
			"optional": true
		},
		"vitest": {
			"optional": true
		}
	},
	"engines": {
		"node": ">=24"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	}
}
