{
	"name": "@shivaedev/effect-changes",
	"version": "0.3.0",
	"description": "Commit-bound change channels for Effect: publish recorded changes only after the transaction commits",
	"homepage": "https://github.com/ShivaeDev/platform/tree/main/packages/effect-changes#readme",
	"bugs": {
		"url": "https://github.com/ShivaeDev/platform/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ShivaeDev/platform.git",
		"directory": "packages/effect-changes"
	},
	"license": "MIT",
	"sideEffects": false,
	"type": "module",
	"imports": {
		"#test/*": "./src/test-support/*",
		"#*.ts": {
			"source": "./src/*.ts",
			"types": "./dist/*.d.ts",
			"default": "./dist/*.js"
		}
	},
	"exports": {
		"./package.json": "./package.json",
		"./channel.ts": {
			"types": "./dist/channel.d.ts",
			"source": "./src/channel.ts",
			"import": "./dist/channel.js",
			"default": "./dist/channel.js"
		},
		"./frame.ts": {
			"types": "./dist/frame.d.ts",
			"source": "./src/frame.ts",
			"import": "./dist/frame.js",
			"default": "./dist/frame.js"
		},
		"./observe.ts": {
			"types": "./dist/observe.d.ts",
			"source": "./src/observe.ts",
			"import": "./dist/observe.js",
			"default": "./dist/observe.js"
		},
		"./publish.ts": {
			"types": "./dist/publish.d.ts",
			"source": "./src/publish.ts",
			"import": "./dist/publish.js",
			"default": "./dist/publish.js"
		}
	},
	"files": [
		"dist",
		"src",
		"!src/**/*.test.ts",
		"!src/**/*.spec.ts",
		"!src/**/test-support",
		"docs",
		"CHANGELOG.md",
		"README.md"
	],
	"scripts": {
		"build": "node --eval \"import('node:fs').then(({ rmSync }) => rmSync('dist', { force: true, recursive: true }))\" && tsc --project tsconfig.build.json",
		"ready": "pnpm typecheck && pnpm test && pnpm build",
		"test": "vitest run",
		"typecheck": "tsc --noEmit"
	},
	"devDependencies": {
		"@shivaedev/quality": "workspace:*",
		"@types/node": "catalog:",
		"@typescript/native": "catalog:",
		"effect": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	},
	"peerDependencies": {
		"effect": "catalog:"
	},
	"engines": {
		"node": ">=24"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	}
}
