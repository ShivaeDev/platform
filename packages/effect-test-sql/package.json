{
	"name": "@shivaedev/effect-test-sql",
	"version": "0.6.0",
	"description": "PostgreSQL rollback and real-commit test isolation for Effect",
	"homepage": "https://github.com/ShivaeDev/platform/tree/main/packages/effect-test-sql#readme",
	"bugs": {
		"url": "https://github.com/ShivaeDev/platform/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ShivaeDev/platform.git",
		"directory": "packages/effect-test-sql"
	},
	"license": "MIT",
	"sideEffects": false,
	"type": "module",
	"imports": {
		"#test/*": "./src/test-support/*",
		"#*.ts": {
			"source": "./src/server/*.ts",
			"types": "./dist/server/*.d.ts",
			"default": "./dist/server/*.js"
		}
	},
	"exports": {
		"./*.ts": {
			"source": "./src/server/*.ts",
			"types": "./dist/server/*.d.ts",
			"default": "./dist/server/*.js"
		},
		"./internal/*": null,
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"src",
		"!src/**/*.test.ts",
		"!src/**/*.spec.ts",
		"!src/**/test-support",
		"CHANGELOG.md",
		"README.md"
	],
	"scripts": {
		"build": "node --eval \"import('node:fs').then(({ rmSync }) => rmSync('dist', { force: true, recursive: true }))\" && tsc --project tsconfig.build.json",
		"ready": "pnpm typecheck && pnpm test && pnpm build",
		"test": "vitest run",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@shivaedev/effect-sql": "workspace:*"
	},
	"devDependencies": {
		"@effect/sql-pg": "catalog:",
		"@effect/vitest": "catalog:",
		"@shivaedev/effect-test": "workspace:*",
		"@shivaedev/quality": "workspace:*",
		"@shivaedev/test-story": "workspace:*",
		"@types/node": "catalog:",
		"effect": "catalog:",
		"pg-boss": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	},
	"peerDependencies": {
		"@effect/sql-pg": "catalog:",
		"effect": "catalog:"
	},
	"engines": {
		"node": ">=24"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	}
}
