{
	"name": "@shivaedev/starter",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"imports": {
		"#*": "./src/*"
	},
	"scripts": {
		"admin:create": "node --conditions=source --env-file-if-exists=.env.local src/server/admin.ts",
		"baseline": "quality baseline",
		"build": "vite build",
		"check:published": "env -u NODE_OPTIONS node --conditions=source --env-file-if-exists=../../.env.local ../../script/starter-published.ts",
		"ci": "quality ci",
		"db:setup": "node --conditions=source --env-file-if-exists=.env.local src/server/setup-database.ts",
		"dev": "pnpm db:setup && pnpm migrate && node --conditions=source --env-file-if-exists=.env.local src/server/dev.ts",
		"format": "quality fix",
		"lint": "quality lint",
		"migrate": "node --conditions=source --env-file-if-exists=.env.local src/server/migrate.ts",
		"ready": "pnpm run ci",
		"setup": "pnpm install && quality setup",
		"start": "node --conditions=source --env-file-if-exists=.env.local src/server/server.ts",
		"test": "node --env-file-if-exists=.env.local node_modules/vitest/vitest.mjs run",
		"typecheck": "tsc --noEmit",
		"worker": "node --conditions=source --env-file-if-exists=.env.local src/server/worker.ts"
	},
	"dependencies": {
		"@base-ui/react": "catalog:",
		"@effect/atom-react": "catalog:",
		"@effect/platform-node": "catalog:",
		"@effect/sql-pg": "catalog:",
		"@shivaedev/platform": "workspace:*",
		"@tanstack/react-router": "catalog:",
		"@tanstack/react-table": "catalog:",
		"better-auth": "catalog:",
		"class-variance-authority": "catalog:",
		"cn": "catalog:",
		"effect": "catalog:",
		"lucide-react": "catalog:",
		"pg": "catalog:",
		"pg-boss": "catalog:",
		"react": "catalog:",
		"react-dom": "catalog:"
	},
	"devDependencies": {
		"@effect/vitest": "catalog:",
		"@shivaedev/quality": "workspace:*",
		"@shivaedev/test-story": "workspace:*",
		"@tailwindcss/vite": "catalog:",
		"@types/node": "catalog:",
		"@types/pg": "catalog:",
		"@types/react": "catalog:",
		"@types/react-dom": "catalog:",
		"@vitejs/plugin-react": "catalog:",
		"happy-dom": "catalog:",
		"railway": "catalog:",
		"shadcn": "catalog:",
		"tailwindcss": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vitest": "catalog:"
	},
	"packageManager": "pnpm@12.15.0",
	"engines": {
		"node": ">=24"
	}
}
