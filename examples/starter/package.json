{
	"name": "@shivaedev/starter",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"imports": {
		"#*": "./src/*"
	},
	"scripts": {
		"admin:create": "node --conditions=@shivaedev/source --env-file-if-exists=.env.local src/server/admin/run.ts",
		"baseline": "quality baseline",
		"browser-check": "browser-check",
		"build": "vite build",
		"check:published": "env -u NODE_OPTIONS node --conditions=@shivaedev/source --env-file-if-exists=../../.env.local ../../script/starter-published.ts",
		"ci": "quality ci",
		"db:seed": "node --conditions=@shivaedev/source --env-file-if-exists=.env.local src/server/run-seed.ts",
		"db:setup": "node --conditions=@shivaedev/source --env-file-if-exists=.env.local src/server/setup-database.ts",
		"dev": "pnpm db:setup && pnpm migrate && node --conditions=@shivaedev/source --env-file-if-exists=.env.local src/server/dev.ts",
		"format": "quality fix",
		"lint": "node --conditions=@shivaedev/source tooling/heavy.ts -- sh -c 'pnpm lint:skills && quality lint'",
		"lint:skills": "shivaedev-skills check",
		"migrate": "node --conditions=@shivaedev/source --env-file-if-exists=.env.local src/server/migrate.ts",
		"postgres:low-memory": "node --conditions=@shivaedev/source --env-file-if-exists=.env.local src/server/low-memory-postgres.ts",
		"postgres:trim-cache": "node --conditions=@shivaedev/source --env-file-if-exists=.env.local src/server/trim-postgres-page-cache.ts",
		"ready": "pnpm run ci",
		"setup": "pnpm install && pnpm skills:sync && quality setup",
		"skills:sync": "shivaedev-skills sync",
		"start": "node --conditions=@shivaedev/source --env-file-if-exists=.env.local src/server/server.ts",
		"test": "node --conditions=@shivaedev/source tooling/heavy.ts -- node --conditions=@shivaedev/source --env-file-if-exists=.env.local tooling/test.ts",
		"typecheck": "node --conditions=@shivaedev/source tooling/heavy.ts -- tsc --noEmit",
		"worker": "node --conditions=@shivaedev/source --env-file-if-exists=.env.local src/server/worker.ts"
	},
	"dependencies": {
		"@base-ui/react": "catalog:",
		"@effect/atom-react": "catalog:",
		"@effect/platform-node": "catalog:",
		"@effect/sql-pg": "catalog:",
		"@shivaedev/deploy": "workspace:*",
		"@shivaedev/platform": "workspace:*",
		"@tanstack/react-router": "catalog:",
		"@tanstack/react-table": "catalog:",
		"better-auth": "catalog:",
		"class-variance-authority": "catalog:",
		"cn": "catalog:",
		"effect": "catalog:",
		"lucide-react": "catalog:",
		"react": "catalog:",
		"react-dom": "catalog:"
	},
	"devDependencies": {
		"@effect/vitest": "catalog:",
		"@shivaedev/browser-check": "workspace:*",
		"@shivaedev/heavy-lock": "workspace:*",
		"@shivaedev/quality": "workspace:*",
		"@shivaedev/skills": "workspace:*",
		"@shivaedev/test-kits": "workspace:*",
		"@shivaedev/test-story": "workspace:*",
		"@shivaedev/vitest-rerun": "workspace:*",
		"@tailwindcss/vite": "catalog:",
		"@types/node": "catalog:",
		"@types/react": "catalog:",
		"@types/react-dom": "catalog:",
		"@vitejs/plugin-react": "catalog:",
		"happy-dom": "catalog:",
		"railway": "catalog:",
		"tailwindcss": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vitest": "catalog:"
	},
	"packageManager": "pnpm@12.16.1",
	"engines": {
		"node": ">=24"
	},
	"quality": {
		"toolOwned": [
			{
				"glob": "src/client/ui/badge.tsx",
				"reason": "shadcn owns this stock base-mira registry component."
			},
			{
				"glob": "src/client/ui/button.tsx",
				"reason": "shadcn owns this stock base-mira registry component."
			},
			{
				"glob": "src/client/ui/card.tsx",
				"reason": "shadcn owns this stock base-mira registry component."
			},
			{
				"glob": "src/client/ui/dialog.tsx",
				"reason": "shadcn owns this stock base-mira registry component."
			},
			{
				"glob": "src/client/ui/input.tsx",
				"reason": "shadcn owns this stock base-mira registry component."
			},
			{
				"glob": "src/client/ui/select.tsx",
				"reason": "shadcn owns this stock base-mira registry component."
			},
			{
				"glob": "src/client/ui/switch.tsx",
				"reason": "shadcn owns this stock base-mira registry component."
			},
			{
				"glob": "src/client/ui/table.tsx",
				"reason": "shadcn owns this stock base-mira registry component."
			},
			{
				"glob": "src/client/ui/tabs.tsx",
				"reason": "shadcn owns this stock base-mira registry component."
			},
			{
				"glob": "src/client/ui/textarea.tsx",
				"reason": "shadcn owns this stock base-mira registry component."
			}
		]
	},
	"shivaedevSkills": [
		"story-testing"
	]
}
