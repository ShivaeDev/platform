{
	"name": "@shivaedev/starter",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"imports": {
		"#*": "./src/*",
		"#client/ui/*": "./src/client/ui/*.tsx"
	},
	"scripts": {
		"build": "vite build",
		"check:published": "node --conditions=source --env-file-if-exists=../../.env.local ../../script/starter-published.ts",
		"ci": "pnpm lint && pnpm typecheck && pnpm build && pnpm test",
		"db:setup": "node --conditions=source --env-file-if-exists=.env.local src/server/setup-database.ts",
		"dev": "pnpm db:setup && pnpm migrate && node --conditions=source --env-file-if-exists=.env.local src/server/dev.ts",
		"format": "quality fix",
		"lint": "quality lint",
		"migrate": "node --conditions=source --env-file-if-exists=.env.local src/server/migrate.ts",
		"ready": "pnpm run ci",
		"setup": "pnpm install && node src/setup.ts",
		"start": "node --conditions=source --env-file-if-exists=.env.local src/server/server.ts",
		"test": "node --env-file-if-exists=.env.local node_modules/vitest/vitest.mjs run",
		"typecheck": "tsc6 --noEmit",
		"worker": "node --conditions=source --env-file-if-exists=.env.local src/server/worker.ts"
	},
	"dependencies": {
		"@effect/atom-react": "catalog:",
		"@effect/platform-node": "catalog:",
		"@effect/sql-pg": "catalog:",
		"@shivaedev/effect-contract": "workspace:*",
		"@shivaedev/effect-form": "workspace:*",
		"@shivaedev/effect-pg-boss": "workspace:*",
		"@shivaedev/effect-react": "workspace:*",
		"@shivaedev/effect-service": "workspace:*",
		"@shivaedev/effect-sql": "workspace:*",
		"@shivaedev/local-postgres": "workspace:*",
		"@shivaedev/platform": "workspace:*",
		"@tanstack/react-router": "catalog:",
		"@tanstack/react-table": "catalog:",
		"better-auth": "catalog:",
		"class-variance-authority": "catalog:",
		"clsx": "catalog:",
		"cn": "catalog:",
		"effect": "catalog:",
		"lucide-react": "catalog:",
		"pg": "catalog:",
		"radix-ui": "catalog:",
		"react": "catalog:",
		"react-dom": "catalog:",
		"recharts": "catalog:",
		"tailwind-merge": "catalog:"
	},
	"devDependencies": {
		"@effect/vitest": "catalog:",
		"@shivaedev/effect-test": "workspace:*",
		"@shivaedev/effect-test-sql": "workspace:*",
		"@shivaedev/quality": "workspace:*",
		"@shivaedev/test-story": "workspace:*",
		"@tailwindcss/vite": "catalog:",
		"@types/node": "catalog:",
		"@types/pg": "catalog:",
		"@types/react": "catalog:",
		"@types/react-dom": "catalog:",
		"@vitejs/plugin-react": "catalog:",
		"happy-dom": "catalog:",
		"railway": "catalog:",
		"tailwindcss": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vitest": "catalog:"
	},
	"packageManager": "pnpm@12.8.1",
	"engines": {
		"node": ">=24"
	}
}
